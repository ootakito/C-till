class ABC
{
    static void Main()
    {
        int[] numbers = new int[3]; // 要素数3の配列を作成
        numbers[0] = 10;            // 1番目の要素に10を代入
        numbers[1] = 20;            // 2番目の要素に20を代入
        numbers[2] = 30;            // 3番目の要素に30を代入

        Console.WriteLine(numbers[0]); // 出力: 10
        Console.WriteLine(numbers[1]); // 出力: 20
        Console.WriteLine(numbers[2]); // 出力: 30





    }
}

int[] numbers = new int[3];ここで配列の数を作成する３はインデックス番号で０１２になる。


class ABC
{
    static void Main()
    {
        int[] numbers = new int[5]; // 5つの数値を格納する配列

        for (int i = 0; i < numbers.Length; i++)
        {
            while (true)
            {
                Console.WriteLine($"{i + 1}つ目の数値を入力してください:");
                string input = Console.ReadLine();

                if (int.TryParse(input, out int value))
                {
                    numbers[i] = value; // 配列に値を格納
                    break; // 正常な入力ならループを抜ける
                }
                else
                {
                    Console.WriteLine("不正な入力です。数値を入力してください。");
                }
            }
        }

        // 合計と平均を計算
        int sum = 0;
        for (int i = 0; i < numbers.Length; i++)
        {
            sum += numbers[i];
        }
        double average = (double)sum / numbers.Length;

        Console.WriteLine($"合計: {sum}");
        Console.WriteLine($"平均: {average:F2}");
    }
}

